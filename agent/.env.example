# ---- Alem AI Plus (OpenAI-compatible gateway) -------------------------------
# Base URL must be the path that has /chat/completions under it, e.g.
#   https://<host>/v1
LLM_BASE_URL=
LLM_API_KEY=

# Exact model ids as the gateway expects them
LLM_MODEL=                 # primary reasoning model (e.g. AlemLLM)
LLM_MODEL_B=               # optional second model, used only to cross-check flagged cells
EMBED_MODEL=               # Embedder, for RAG vectors
RERANK_MODEL=              # Reranker, for retrieval precision
RERANK_URL=                # only if rerank is NOT at {LLM_BASE_URL}/rerank

# ---- guardrails -------------------------------------------------------------
LLM_TEMPERATURE=0
LLM_TIMEOUT=90
LLM_MAX_RETRIES=4
LLM_BUDGET_CALLS=600       # hard ceiling; a runaway loop cannot eat the window

# ---- optional tracing -------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- submission identity ----------------------------------------------------
TEAM_NAME=KOZ
CONTACT_EMAIL=orynbekkairo@gmail.com
SUBMISSION_MODEL_LABEL=
